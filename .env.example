# Copia este archivo a .env y completa tus claves. NUNCA subas .env a git.

# Proveedor activo: "anthropic" u "openai"
LLM_PROVIDER=anthropic

# Solo necesitas la clave del proveedor que uses
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opcional: modelo por proveedor (si se omite se usa el predeterminado)
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-4o-mini
